MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/taskmanager
JWT_SECRET=replace_this_with_a_long_random_string
PORT=5000
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_16_character_app_password
GEMINI_API_KEY=your_real_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional - only needed if you want real CAPTCHA verification on top of
# the built-in honeypot/rate-limiting. Leave blank to skip it entirely.
# Get a free v3 key at https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=
